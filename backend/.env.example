# ==============================================================================
# QISSA CAFE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Cloud Database & Storage)
# ------------------------------------------------------------------------------
# Found in your Supabase Dashboard: Project Settings -> API
# 1. Project URL (e.g. https://yourprojectid.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase API Key (service_role key recommended for backend, or anon key)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-or-anon-key
SUPABASE_KEY=your-supabase-service-role-key-or-anon-key

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Flask secret key for signing session cookies (generate with `python backend/generate_secrets.py`)
QISSA_SECRET_KEY=change-this-secret-before-production-run-generate-secrets

# Private Admin Dashboard Password
QISSA_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Cookie Security (set to 1 when serving over HTTPS / SSL in production)
QISSA_COOKIE_SECURE=0

# Flask Debug Mode (0 for production, 1 for local development)
FLASK_DEBUG=1

# Server Port
PORT=5000
